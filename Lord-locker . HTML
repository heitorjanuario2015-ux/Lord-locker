<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lord Locker</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Arial, sans-serif;
            background: #090d16;
            color: #f8fafc;
            padding: 12px;
        }
        h1 { text-align: center; color: #fbbf24; margin-bottom: 12px; font-size: 1.5rem; }
        .top {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
            margin-bottom: 12px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
        .stat {
            background: #0f172a;
            padding: 8px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid rgba(251, 191, 36, 0.3);
        }
        .stat b { display: block; color: #fbbf24; font-size: 15px; }
        .stat span { font-size: 9px; color: #94a3b8; text-transform: uppercase; }
        
        .actions-bar {
            display: flex;
            gap: 6px;
            margin-bottom: 12px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }
        .action-btn {
            flex: 1;
            background: #1d4ed8;
            color: #fff;
            border: none;
            padding: 10px 4px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 11px;
            cursor: pointer;
            text-align: center;
        }
        .action-btn.print-btn { background: #047857; }

        .grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 600px;
            margin: 0 auto;
        }
        .card {
            background: #0f172a;
            border-radius: 10px;
            border: 1px solid #334155;
            overflow: hidden;
        }
        .card-title {
            background: #1e293b;
            color: #fbbf24;
            padding: 8px 12px;
            font-weight: bold;
            font-size: 13px;
        }
        .row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            border-top: 1px solid #1e293b;
            gap: 6px;
        }
        .sprite-img {
            width: 38px;
            height: 38px;
            border-radius: 6px;
            background: #020617;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            color: #94a3b8;
            cursor: pointer;
            object-fit: cover;
            border: 1px solid #475569;
            flex-shrink: 0;
        }
        .row b { font-size: 12px; flex: 1; color: #f1f5f9; }
        .row-buttons { display: flex; gap: 4px; }
        .btn {
            padding: 6px 8px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: bold;
            border: none;
            cursor: pointer;
            background: #334155;
            color: #94a3b8;
        }
        .btn-col.active { background: #2563eb; color: #fff; }
        .btn-dom.active { background: #16a34a; color: #fff; }
        .btn-des.active { background: #ca8a04; color: #fff; }

        /* Galeria Definitiva com 8 Colunas (Encaixe Perfeito) */
        #galleryModal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #090d16;
            z-index: 2000;
            flex-direction: column;
            padding: 6px;
            overflow-y: auto;
        }
        .gallery-header { text-align: center; margin-bottom: 4px; flex-shrink: 0; }
        .gallery-header h2 { color: #fbbf24; font-size: 1rem; }
        .gallery-header p { color: #94a3b8; font-size: 8px; }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr); /* 8 colunas para preencher perfeitamente toda a largura */
            gap: 2px;
            max-width: 100%;
            margin: 0 auto 8px auto;
            flex: 1;
        }
        .gallery-card {
            background: #0f172a;
            border: 1px solid rgba(251, 191, 36, 0.2);
            border-radius: 3px;
            padding: 2px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1px;
        }
        .gallery-card.missing { opacity: 0.25; border-color: #334155; }
        .gallery-card img, .gallery-card .g-placeholder {
            width: 20px;
            height: 20px;
            border-radius: 2px;
            object-fit: cover;
        }
        .gallery-card b { font-size: 5px; color: #f8fafc; line-height: 1; }
        .gallery-card span { font-size: 4.5px; color: #10b981; font-weight: bold; }
        .gallery-card.missing span { color: #64748b; }
        
        .close-gallery {
            background: #dc2626;
            color: white;
            border: none;
            padding: 6px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 10px;
            cursor: pointer;
            max-width: 180px;
            margin: 0 auto;
            width: 100%;
            flex-shrink: 0;
        }
    </style>
</head>
<body>

    <h1>Lord Locker</h1>

    <div class="top">
        <div class="stat"><b id="co">0</b><span>Coletados</span></div>
        <div class="stat"><b id="do">0</b><span>Dominados</span></div>
        <div class="stat"><b id="pc">0%</b><span>Progresso</span></div>
    </div>

    <div class="actions-bar">
        <button class="action-btn print-btn" onclick="openGallery()">📸 Ver Galeria Perfeita (8 Colunas)</button>
        <button class="action-btn" onclick="resetApp()" style="background: #991b1b;">Apagar</button>
    </div>

    <main id="grid" class="grid"></main>

    <input type="file" id="fileInput" accept="image/*" style="display:none" onchange="processFile(event)">

    <div id="galleryModal">
        <div class="gallery-header">
            <h2>👑 Coleção Completa (Encaixe de 8 Colunas)</h2>
            <p>Tire um print para mandar no WhatsApp!</p>
        </div>
        <div class="gallery-grid" id="galleryContainer"></div>
        <button class="close-gallery" onclick="closeGallery()">❌ Voltar</button>
    </div>

    <script>
        const sprites = [
            'Arbusto', 'Jonesy', 'Aventura', '8-Bit', 'Onigiri', 
            'Sonic', 'Tails', 'Shadow', 'Sobrescudo', 'Disruptor', 
            'Jackrabbit', 'Raio X', 'Klombo', 'Coroa', 'Mega Man'
        ];
        
        const variants = [
            ['b', 'Norm'], 
            ['g', 'Gold'], 
            ['c', 'Trap'],
            ['l', 'Hack']
        ];

        let activeKey = null;

        let data = JSON.parse(localStorage.getItem('lord_locker_data') || localStorage.getItem('lord_data_v2') || localStorage.getItem('lord_data') || '{}');
        let userImages = JSON.parse(localStorage.getItem('lord_locker_base64_imgs') || localStorage.getItem('lord_imgs_v2') || localStorage.getItem('lord_imgs') || '{}');

        function render() {
            let html = '';
            let coletados = 0;
            let dominados = 0;
            let total = sprites.length * variants.length;

            for (let i = 0; i < sprites.length; i++) {
                let sprite = sprites[i];
                let cardContent = '';

                for (let j = 0; j < variants.length; j++) {
                    let v = variants[j];
                    let key = sprite + '_' + v[0];
                    let x = data[key] || {col: false, dom: false, des: false};
                    
                    if (x.col) coletados++;
                    if (x.dom) dominados++;

                    let colClass = x.col ? 'btn btn-col active' : 'btn btn-col';
                    let domClass = x.dom ? 'btn btn-dom active' : 'btn btn-dom';
                    let desClass = x.des ? 'btn btn-des active' : 'btn btn-des';
                    let vName = v[1] + (x.dom ? ' 👑' : '');
                    
                    let imgContent = userImages[key] ? 
                        `<img src="${userImages[key]}" class="sprite-img" onclick="pick('${key}')">` : 
                        `<div class="sprite-img" onclick="pick('${key}')">Foto</div>`;

                    cardContent += `
                        <div class="row">
                            ${imgContent}
                            <b>${vName}</b>
                            <div class="row-buttons">
                                <button class="${colClass}" onclick="toggle('${key}', 'col')">Coletar</button>
                                <button class="${domClass}" onclick="toggle('${key}', 'dom')">Dominar</button>
                                <button class="${desClass}" onclick="toggle('${key}', 'des')">Desdominar</button>
                            </div>
                        </div>`;
                }
                html += `<div class="card"><div class="card-title">${sprite}</div>${cardContent}</div>`;
            }

            document.getElementById('grid').innerHTML = html;
            document.getElementById('co').innerText = coletados;
            document.getElementById('do').innerText = dominados;
            document.getElementById('pc').innerText = Math.round((coletados / total) * 100) + '%';
            
            localStorage.setItem('lord_locker_data', JSON.stringify(data));
            localStorage.setItem('lord_locker_base64_imgs', JSON.stringify(userImages));
        }

        function pick(key) {
            activeKey = key;
            document.getElementById('fileInput').click();
        }

        function processFile(e) {
            const file = e.target.files[0];
            if (file && activeKey) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const MAX_SIZE = 70;
                        let width = img.width, height = img.height;
                        if (width > height) {
                            if (width > MAX_SIZE) { height *= MAX_SIZE / width; width = MAX_SIZE; }
                        } else {
                            if (height > MAX_SIZE) { width *= MAX_SIZE / height; height = MAX_SIZE; }
                        }
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        
                        userImages[activeKey] = canvas.toDataURL('image/jpeg', 0.5);
                        render();
                    };
                    img.src = evt.target.result;
                };
                reader.readAsDataURL(file);
            }
            e.target.value = '';
        }

        function toggle(key, type) {
            if (!data[key]) data[key] = {col: false, dom: false, des: false};
            data[key][type] = !data[key][type];
            render();
        }

        function openGallery() {
            let container = document.getElementById('galleryContainer');
            let html = '';

            for (let i = 0; i < sprites.length; i++) {
                let sprite = sprites[i];
                for (let j = 0; j < variants.length; j++) {
                    let v = variants[j];
                    let key = sprite + '_' + v[0];
                    let x = data[key] || {col: false, dom: false};

                    let isOwned = x.col || x.dom;
                    let cardClass = isOwned ? 'gallery-card' : 'gallery-card missing';
                    let imgTag = userImages[key] ? `<img src="${userImages[key]}">` : `<div class="g-placeholder" style="background:#1e293b;"></div>`;
                    let status = x.dom ? '👑 Dom' : (x.col ? '📦 Obt' : 'Falta');

                    html += `
                        <div class="${cardClass}">
                            ${imgTag}
                            <div>
                                <b>${sprite}<br>(${v[1]})</b>
                                <span>${status}</span>
                            </div>
                        </div>`;
                }
            }

            container.innerHTML = html;
            document.getElementById('galleryModal').style.display = 'flex';
        }

        function closeGallery() {
            document.getElementById('galleryModal').style.display = 'none';
        }

        function resetApp() {
            if (confirm("Apagar tudo?")) {
                localStorage.clear();
                data = {};
                userImages = {};
                render();
            }
        }

        render();
    </script>
</body>
</html>
